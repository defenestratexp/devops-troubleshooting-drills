# Dependency trees belong to the exercise, not to the repository. Several of the
# app-level drills ship a package.json; the modules are restored by running the
# exercise, and committing them would multiply the file count roughly fivefold.
node_modules/
__pycache__/
*.pyc
.terraform/
*.tfstate
*.tfstate.*
.env.local

# Exercise working output. Every c* drill writes under out/ and rebuilds it from
# scratch on each verify, and the c3 grader stages a throwaway tree in .work/.
out/
.work/
.terraform.lock.hcl

# Your own answers to the reasoning drills. Yours to keep, not to commit --
# a repo with the answers in it is no longer a drill for the next person.
ANSWERS.md
