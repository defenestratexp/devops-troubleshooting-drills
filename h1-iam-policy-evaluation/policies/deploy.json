{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Artifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::n9n-artifacts"
    },
    {
      "Sid": "DeployerConvenience",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::n9n-*/*"
    },
    {
      "Sid": "NoCustomerData",
      "Effect": "Deny",
      "NotAction": "s3:GetObject",
      "Resource": "arn:aws:s3:::n9n-customer-data/*"
    }
  ]
}
